# Copy to .env (same folder as package.json) and fill in what you need. All optional.

# Password for the Superadmin panel (#admin): token system, prices, items, wallets.
SUPERADMIN_PASSWORD=

# Behind a CDN, name its country header (e.g. cf-ipcountry) so AUD pricing follows real
# geolocation. Without it, the browser's time zone and language decide.
# GEO_COUNTRY_HEADER=cf-ipcountry

# Enables the AI analyst (Claude Opus 5.5 + web search). Billed to your Anthropic account.
ANTHROPIC_API_KEY=

# Override the AI model (default claude-opus-5-5).
# AI_MODEL=claude-opus-5-5

# Public host names the app answers to (comma-separated), e.g. a custom domain. Vercel's own
# *.vercel.app domains are allowed automatically. Requests for any other host get 403.
# ALLOWED_HOSTS=finance.example.com

# Web server. Keep HOST=127.0.0.1 unless you want other devices on your network to reach the app.
PORT=3000
HOST=127.0.0.1
