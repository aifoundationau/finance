# Copy to .env (same folder as package.json) and fill in what you need. All optional locally.
# For Vercel, put the same names in Project > Settings > Environment Variables.

# --- Superadmin panel (#admin): token system, prices, items, wallets; on a public deployment also
# settings and report runs. Google sign-in is used when all three Google values are set;
# otherwise SUPERADMIN_PASSWORD (fine on your own computer, not for a public site).
# GOOGLE_CLIENT_ID=614773274800-9pooin0jia9ij91qjlk7r6r6ne02mbhg.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# SUPERADMIN_EMAILS=you@example.com
SUPERADMIN_PASSWORD=

# Signs session cookies. Set a long random value on any deployment with several instances.
# SESSION_SECRET=

# --- Storage. Without this, data is kept in data/ next to package.json. With a Firebase
# service-account key (JSON on one line, or base64 of it), data is kept in Cloud Firestore.
# FIREBASE_SERVICE_ACCOUNT=
# FIRESTORE_DATABASE_ID=(default)

# --- Vercel Cron authenticates to /api/cron/daily with this (Authorization: Bearer ...).
# CRON_SECRET=

# Behind a CDN, name its country header so AUD pricing follows real geolocation
# (x-vercel-ip-country on Vercel, cf-ipcountry on Cloudflare). Without it, the browser's time zone
# and language decide.
# GEO_COUNTRY_HEADER=x-vercel-ip-country

# Enables the AI analyst (Claude Opus 5.5 + web search). Billed to your Anthropic account.
ANTHROPIC_API_KEY=

# Override the AI model (default claude-opus-5-5).
# AI_MODEL=claude-opus-5-5

# Public host names the app answers to (comma-separated), e.g. a custom domain. Vercel's own
# *.vercel.app domains are allowed automatically. Requests for any other host get 403.
# ALLOWED_HOSTS=finance.example.com

# Web server. Keep HOST=127.0.0.1 unless you want other devices on your network to reach the app.
PORT=3000
HOST=127.0.0.1
